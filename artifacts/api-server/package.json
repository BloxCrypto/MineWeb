{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "PORT=${PORT:-3000} BASE_PATH=${BASE_PATH:-/} pnpm --filter @workspace/minecraft-bot build && node ./build.mjs",
    "start": "node --env-file-if-exists=/vercel/share/.env.project --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/http-proxy": "^1.17.17",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "mineflayer": "^4.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prismarine-viewer": "^1.33.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
